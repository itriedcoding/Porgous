{
  "id": "palworld",
  "name": "Palworld",
  "description": "Palworld dedicated server based on the maintained thijsvanloef image.",
  "category": "Survival",
  "docker_images": ["thijsvanloef/palworld-server-docker:latest"],
  "startup": "",
  "stop_command": "save",
  "startup_detection": "Server is running",
  "install": {
    "image": "alpine:3.20",
    "script": "set -e\nmkdir -p Pal/Saved\necho 'Palworld server files are downloaded by the container image on first start.'\necho 'Install complete'"
  },
  "variables": [
    {"key": "SERVER_NAME", "name": "Server name", "default_value": "Porgous Palworld", "user_editable": true, "rules": "required|max:64"},
    {"key": "SERVER_DESCRIPTION", "name": "Description", "default_value": "Hosted with Porgous", "user_editable": true, "rules": "max:128"},
    {"key": "SERVER_PASSWORD", "name": "Join password", "default_value": "", "user_editable": true, "rules": "max:64"},
    {"key": "ADMIN_PASSWORD", "name": "Admin password", "default_value": "", "user_editable": true, "rules": "max:64"},
    {"key": "PLAYERS", "name": "Max players", "default_value": "16", "user_editable": true, "rules": "required|integer"},
    {"key": "COMMUNITY", "name": "Community server", "default_value": "false", "user_editable": true, "rules": "in:true,false"}
  ],
  "ports": [
    {"name": "Game", "port": 8211, "protocol": "udp"},
    {"name": "Query", "port": 27015, "protocol": "udp"}
  ],
  "notes": "Palworld needs at least 8 GB of RAM for a small server. The image restarts periodically for updates.",
  "version": 1
}
