{
  "id": "rust",
  "name": "Rust Dedicated Server",
  "description": "Facepunch Rust dedicated server with Oxide optional through the image.",
  "category": "Survival",
  "docker_images": ["didstopia/rust-server:latest"],
  "startup": "",
  "stop_command": "quit",
  "startup_detection": "Server startup complete",
  "install": {
    "image": "alpine:3.20",
    "script": "set -e\nmkdir -p serverdata/rustserver\necho 'Rust server files are downloaded by the container image on first start.'\necho 'Install complete'"
  },
  "variables": [
    {"key": "RUST_SERVER_NAME", "name": "Server name", "default_value": "Porgous Rust", "user_editable": true, "rules": "required|max:64"},
    {"key": "RUST_SERVER_DESCRIPTION", "name": "Description", "default_value": "Hosted with Porgous", "user_editable": true, "rules": "max:256"},
    {"key": "RUST_SERVER_SEED", "name": "World seed", "default_value": "12345", "user_editable": true, "rules": "integer"},
    {"key": "RUST_SERVER_WORLDSIZE", "name": "World size", "default_value": "3000", "user_editable": true, "rules": "required|integer|between:1000,6000"},
    {"key": "RUST_RCON_PASSWORD", "name": "RCON password", "default_value": "", "user_editable": true, "rules": "max:64"},
    {"key": "RUST_SERVER_MAXPLAYERS", "name": "Max players", "default_value": "50", "user_editable": true, "rules": "required|integer"}
  ],
  "ports": [
    {"name": "Game", "port": 28015, "protocol": "udp"},
    {"name": "Query", "port": 28016, "protocol": "tcp"}
  ],
  "notes": "Rust needs several gigabytes of RAM and disk. Allow 10-15 minutes for the first install.",
  "version": 1
}
