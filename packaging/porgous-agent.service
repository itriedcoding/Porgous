[Unit]
Description=Porgous node agent
Documentation=https://github.com/itriedcoding/Porgous
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=porgous
Group=porgous
ExecStart=/usr/local/bin/porgous-agent serve --config /etc/porgous/agent.toml
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/porgous-node
SupplementaryGroups=docker
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
